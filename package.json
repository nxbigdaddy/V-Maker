{
  "name": "v-maker-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "build:web": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "test": "pnpm typecheck && vitest run",
    "test:web": "vitest run",
    "test:web:watch": "vitest",
    "test:all": "powershell -ExecutionPolicy Bypass -File scripts/test-all.ps1",
    "doctor": "powershell -ExecutionPolicy Bypass -File scripts/doctor.ps1",
    "dev:all": "powershell -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@tauri-apps/cli": "latest",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "jsdom": "^30.1.1",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "^5.0.2"
  }
}
