# Frontend local API address
VITE_API_BASE_URL=http://127.0.0.1:8765/api

# Backend runtime settings
VMAKER_HOST=127.0.0.1
VMAKER_PORT=8765
VMAKER_DATA_DIR=./data

# Persistent task queue: the background worker drains tasks that were left queued or running
# by an interrupted process. Set VMAKER_WORKER_ENABLED=0 to leave the queue to manual
# POST /api/tasks/{id}/execute calls, and tune the idle poll delay with VMAKER_WORKER_POLL_SECONDS.
VMAKER_WORKER_ENABLED=1
VMAKER_WORKER_POLL_SECONDS=1.0
# A task still queued after this many seconds is adopted by the worker. This only matters when
# BackgroundTasks failed to start it at all; it stops a stuck task from sitting in "queued" forever.
VMAKER_WORKER_STALE_SECONDS=30.0

# Optional: voice name sent to an OpenAI-compatible /audio/speech endpoint.
# The image and speech capabilities are configured through /api/capability-settings instead.
VMAKER_SPEECH_VOICE=
